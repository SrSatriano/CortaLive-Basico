# =====================================================================
#  CortaLive Básico — configurações
#
#  COMO USAR: copie este arquivo, renomeie a cópia para  .env  (só isso,
#  com o ponto na frente) e preencha o que quiser. Linhas que começam
#  com # são comentários e são ignoradas.
#
#  NUNCA compartilhe o seu .env: ele guarda as SUAS chaves de IA.
# =====================================================================


# ---------------------------------------------------------------------
#  1) INTELIGÊNCIA ARTIFICIAL (escolha UMA ou mais; a chave é sua)
#
#  A IA assiste à transcrição de cada momento forte, dá nota de 0 a 10
#  e escreve título, legenda e hashtags. Sem nenhuma chave o programa
#  ainda funciona, mas escolhe os momentos só pelo volume do áudio e
#  usa títulos genéricos.
#
#  Como pegar cada chave: veja o README (seção "Chave de IA").
# ---------------------------------------------------------------------

# Google Gemini (tem cota gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (Anthropic): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vertex AI (Google Cloud): caminho do arquivo JSON da conta de serviço.
# Exemplo:  VERTEX_CRED=C:\Users\voce\Documentos\minha-conta-de-servico.json
VERTEX_CRED=
# VERTEX_LOCATION=global

# Se tiver mais de uma chave, qual tentar primeiro: gemini, claude, openai ou vertex
# IA=gemini

# Modelos (opcional; deixe comentado para usar o padrão)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# VERTEX_MODEL=gemini-2.5-flash


# ---------------------------------------------------------------------
#  2) CORTES
# ---------------------------------------------------------------------

# Quantos cortes no máximo por vídeo (os de nota mais alta). 0 = sem limite.
MAX_CORTES=10

# Duração dos cortes em segundos. O TikTok só paga vídeos com mais de 1 minuto.
CORTE_MIN_SEG=72
CORTE_MAX_SEG=150
CORTE_ALVO_SEG=95

# Nota mínima (0 a 10) que a IA precisa dar para o momento virar corte.
NOTA_MINIMA=6.5

# Assunto do canal, ajuda a IA a escrever títulos melhores (ex.: Minecraft, futebol, podcast).
# Deixe vazio para genérico.
TEMA=

# Hashtags que vão em todo post (mantenha as aspas).
HASHTAGS_FIXAS="#cortes #shorts"


# ---------------------------------------------------------------------
#  3) APARÊNCIA
# ---------------------------------------------------------------------

# Marca d'água no meio do vídeo (ex.: MARCA="@seucanal"). Vazio = sem marca d'água.
MARCA=


# ---------------------------------------------------------------------
#  4) TRANSCRIÇÃO E DESEMPENHO (normalmente não precisa mexer)
# ---------------------------------------------------------------------

# Modelo do Whisper: tiny, base, small (padrão), medium. Maior = melhor e mais lento.
WHISPER_MODELO=small
# Idioma falado no vídeo (pt, en, es...).
WHISPER_IDIOMA=pt

# Quantas partes do vídeo analisar ao mesmo tempo (PC fraco: 1).
TRABALHADORES=2

# Qualidade do vídeo final: CRF menor = melhor e arquivo maior (18 a 23 é bom).
CRF=20

# Onde guardar cache e progresso (padrão: pasta "dados" do programa).
# CORTALIVE_DADOS=

# Caminho do ffmpeg, se ele não for encontrado sozinho.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
